<Window x:Class="WinNotch.Views.TrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinNotch.Views.Controls"
        Title="WinNotch Tray Menu"
        Width="276"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppleFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Deactivated="OnWindowDeactivated"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Frosted G2 Squircle Menu Row Button -->
        <Style x:Key="TrayMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:SquircleBorder x:Name="ItemBd"
                                                 CornerRadius="7.5"
                                                 Background="Transparent"
                                                 BorderBrush="Transparent"
                                                 BorderThickness="1"
                                                 Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </controls:SquircleBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#20FFFFFF" />
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#2EFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#2EFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive Exit Menu Row Button -->
        <Style x:Key="TrayExitItemButtonStyle" TargetType="Button" BasedOn="{StaticResource TrayMenuItemButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:SquircleBorder x:Name="ItemBd"
                                                 CornerRadius="7.5"
                                                 Background="Transparent"
                                                 BorderBrush="Transparent"
                                                 BorderThickness="1"
                                                 Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </controls:SquircleBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#28FF453A" />
                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#52FF453A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Native Frosted Dark G2 Squircle Shell (#0C0F16, Border #28FFFFFF) -->
    <controls:SquircleBorder x:Name="TrayPopupShell"
                             CornerRadius="12"
                             Background="#0C0F16"
                             BorderBrush="#28FFFFFF"
                             BorderThickness="1"
                             Padding="6,6">
        <StackPanel>
            <!-- 1. Mở / Thu gọn WinNotch (Alt+N) -->
            <Button x:Name="ToggleNotchItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleNotchClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Category" Size="13.5" Foreground="#60A5FA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mở / Thu gọn WinNotch" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border Grid.Column="2" CornerRadius="4" Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Alt+N" Foreground="#94A0B8" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Button>

            <!-- 2. Mở Giám sát AI Agents -->
            <Button x:Name="OpenAgentsItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnOpenAgentsClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Hierarchy" Size="13.5" Foreground="#38BDF8" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mở Giám sát AI Agents" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- 3. Mở Giám sát Hệ thống & Mạng -->
            <Button x:Name="OpenSystemItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnOpenSystemClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Activity" Size="13.5" Foreground="#A78BFA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mở Giám sát hệ thống &amp; Mạng" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- 4. Mở Khay giữ file -->
            <Button x:Name="OpenShelfItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnOpenShelfClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Folder2" Size="13.5" Foreground="#FBBF24" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Mở Khay giữ file" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- 5. Tạm ẩn WinNotch -->
            <Button x:Name="ToggleHideItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleHideClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Pin" Size="13.5" Foreground="#93C5FD" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Tạm ẩn WinNotch" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Ellipse x:Name="ManuallyHiddenDot"
                             Grid.Column="2"
                             Width="7"
                             Height="7"
                             Fill="#60A5FA"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="6,0,2,0" />
                </Grid>
            </Button>

            <Border Height="1" Background="#1CFFFFFF" Margin="6,4" />

            <!-- 6. Giữ sáng màn hình (Caffeine) -->
            <Button x:Name="CaffeineItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleCaffeineClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Coffee" Size="13.5" Foreground="#FBBF24" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Giữ sáng màn hình (Caffeine)" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Ellipse x:Name="CaffeineStatusDot"
                             Grid.Column="2"
                             Width="7.5"
                             Height="7.5"
                             Fill="#FBBF24"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="6,0,2,0" />
                </Grid>
            </Button>

            <!-- 7. Khóa Micro toàn hệ thống (Alt+M) -->
            <Button x:Name="MicMuteItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnToggleMicMuteClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="MicrophoneSlash" Size="13.5" Foreground="#F87171" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Khóa Micro toàn hệ thống" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Ellipse x:Name="MicMuteStatusDot"
                             Grid.Column="2"
                             Width="7.5"
                             Height="7.5"
                             Fill="#FF453A"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="0,0,6,0" />
                    <Border Grid.Column="3" CornerRadius="4" Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Alt+M" Foreground="#94A0B8" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Button>

            <!-- 8. Chấm mã màu màn hình (Alt+C) -->
            <Button x:Name="ColorPickerItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnColorPickerClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Colorfilter" Size="13.5" Foreground="#34D399" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Chấm mã màu màn hình" Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border Grid.Column="2" CornerRadius="4" Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="5,1" VerticalAlignment="Center">
                        <TextBlock Text="Alt+C" Foreground="#94A0B8" FontSize="9.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Button>

            <Border Height="1" Background="#1CFFFFFF" Margin="6,4" />

            <!-- 9. Cài đặt WinNotch... -->
            <Button x:Name="SettingsItemBtn"
                    Style="{StaticResource TrayMenuItemButtonStyle}"
                    Click="OnSettingsClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Setting2" Size="13.5" Foreground="#CBD5E1" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Cài đặt WinNotch..." Foreground="#F5F7FC" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Height="1" Background="#1CFFFFFF" Margin="6,4" />

            <!-- 10. Thoát WinNotch -->
            <Button x:Name="ExitItemBtn"
                    Style="{StaticResource TrayExitItemButtonStyle}"
                    Click="OnExitClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconsaxIcon Grid.Column="0" Kind="Close" Size="13" Foreground="#FF453A" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Thoát WinNotch" Foreground="#FCA5A5" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </controls:SquircleBorder>
</Window>
