<Window x:Class="WinNotch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinNotch.Views.Controls"
        Title="Cài đặt WinNotch"
        Width="720"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppleFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Foreground="#F3F5FA"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Icon="pack://application:,,,/WinNotch;component/Assets/app.ico">

    <Window.Resources>
        <!-- Reusable Sidebar Navigation Button -->
        <Style x:Key="SequoiaSidebarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:SquircleBorder x:Name="NavBd"
                                                 CornerRadius="8.5"
                                                 Background="Transparent"
                                                 BorderBrush="Transparent"
                                                 BorderThickness="1"
                                                 Padding="9,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </controls:SquircleBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBd" Property="Background" Value="#16FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="NavBd" Property="Background" Value="#263B82F6" />
                                <Setter TargetName="NavBd" Property="BorderBrush" Value="#4E60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable Visual Preset Card Style -->
        <Style x:Key="SequoiaPresetCardButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:SquircleBorder x:Name="CardBd"
                                                 CornerRadius="10"
                                                 Background="#151926"
                                                 BorderBrush="#252C3F"
                                                 BorderThickness="1.2"
                                                 Padding="11,9">
                            <ContentPresenter />
                        </controls:SquircleBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="#1B2132" />
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#384360" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="CardBd" Property="Background" Value="#203B82F6" />
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Frameless Frosted Dark Outer Window Chrome (CornerRadius=14) -->
    <Border x:Name="SettingsOuterShell"
            CornerRadius="14"
            Background="#0E1118"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- TOP DRAGGABLE HEADER BAR                                            -->
            <!-- =================================================================== -->
            <Border Grid.Row="0"
                    Background="#111520"
                    BorderBrush="#1CFFFFFF"
                    BorderThickness="0,0,0,1"
                    Padding="16,0,14,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SquircleBorder Width="28"
                                                 Height="28"
                                                 CornerRadius="7.5"
                                                 Background="#050507"
                                                 BorderBrush="#32FFFFFF"
                                                 BorderThickness="1"
                                                 Margin="0,0,10,0">
                            <controls:IconsaxIcon Kind="Category"
                                                  Size="14"
                                                  Foreground="#60A5FA"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </controls:SquircleBorder>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WinNotch Settings"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="Dynamic Notch cho Windows 10 &amp; 11 • Phím tắt mở nhanh: Alt + N"
                                       FontSize="10.2"
                                       Foreground="#8E98AE" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:SquircleBorder CornerRadius="6.5"
                                                 Background="#1C3B82F6"
                                                 BorderBrush="#3E60A5FA"
                                                 BorderThickness="1"
                                                 Padding="9,3.5"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModeBadgeText}"
                                       Foreground="#93C5FD"
                                       FontSize="10.2"
                                       FontWeight="SemiBold" />
                        </controls:SquircleBorder>

                        <!-- Close Window Button -->
                        <Button Command="{Binding CancelCommand}"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                Focusable="False"
                                ToolTip="Đóng cửa sổ Cài đặt (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <controls:SquircleBorder x:Name="CloseBd"
                                                             CornerRadius="7.5"
                                                             Background="#16FFFFFF"
                                                             BorderBrush="#24FFFFFF"
                                                             BorderThickness="1">
                                        <controls:IconsaxIcon Kind="Close"
                                                              Size="12"
                                                              Foreground="#D4DCF0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBd" Property="Background" Value="#38FF453A" />
                                            <Setter TargetName="CloseBd" Property="BorderBrush" Value="#66FF453A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- 2-COLUMN MACOS SEQUOIA BODY: LEFT SIDEBAR + RIGHT CONTENT PANE      -->
            <!-- =================================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR (5 Categories) -->
                <Border Grid.Column="0"
                        Background="#131722"
                        BorderBrush="#1CFFFFFF"
                        BorderThickness="0,0,1,0"
                        Padding="10,12,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="DANH MỤC CÀI ĐẶT"
                                       FontSize="9.6"
                                       FontWeight="Bold"
                                       Foreground="#6F7B95"
                                       Margin="6,0,0,8" />

                            <!-- Category 0: Giao diện & Vật lý -->
                            <Button x:Name="SidebarCat0Btn"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SequoiaSidebarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCat0AppearanceSelected}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:SquircleBorder Width="23" Height="23" CornerRadius="6" Background="#243B82F6" Margin="0,0,9,0">
                                        <controls:IconsaxIcon Kind="Setting4" Size="12.5" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <TextBlock Text="Giao diện &amp; Vật lý" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Category 1: AI Agents -->
                            <Button x:Name="SidebarCat1Btn"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SequoiaSidebarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCat1AgentsSelected}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:SquircleBorder Width="23" Height="23" CornerRadius="6" Background="#2238BDF8" Margin="0,0,9,0">
                                        <controls:IconsaxIcon Kind="Hierarchy" Size="12.5" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <TextBlock Text="AI Agents" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Category 2: Tương tác & Cử chỉ -->
                            <Button x:Name="SidebarCat2Btn"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SequoiaSidebarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCat2InteractionSelected}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:SquircleBorder Width="23" Height="23" CornerRadius="6" Background="#248B5CF6" Margin="0,0,9,0">
                                        <controls:IconsaxIcon Kind="Flash" Size="12.5" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <TextBlock Text="Tương tác &amp; Cử chỉ" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Category 3: Thông báo & HUD -->
                            <Button x:Name="SidebarCat3Btn"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="3">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SequoiaSidebarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCat3HudSelected}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:SquircleBorder Width="23" Height="23" CornerRadius="6" Background="#2010B981" Margin="0,0,9,0">
                                        <controls:IconsaxIcon Kind="Notification" Size="12.5" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <TextBlock Text="Thông báo &amp; HUD" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Category 4: Hệ thống & Khay file -->
                            <Button x:Name="SidebarCat4Btn"
                                    Command="{Binding SelectCategoryCommand}"
                                    CommandParameter="4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SequoiaSidebarButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCat4SystemShelfSelected}" Value="True">
                                                <Setter Property="Tag" Value="Selected" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:SquircleBorder Width="23" Height="23" CornerRadius="6" Background="#22F59E0B" Margin="0,0,9,0">
                                        <controls:IconsaxIcon Kind="Folder2" Size="12.5" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </controls:SquircleBorder>
                                    <TextBlock Text="Hệ thống &amp; Khay file" FontSize="11.8" FontWeight="SemiBold" Foreground="#F3F6FC" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Offline Local Storage Indicator -->
                        <Border Grid.Row="1"
                                Background="#10FFFFFF"
                                BorderBrush="#1AFFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="Lưu trữ nội bộ (Zero Cloud)"
                                           Foreground="#9AA6BF"
                                           FontSize="9.8"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StoragePathDisplay}"
                                           ToolTip="{Binding StoragePathDisplay}"
                                           Foreground="#68738D"
                                           FontSize="9.2"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT CONTENT PANE + STICKY FOOTER -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="54" />
                    </Grid.RowDefinitions>

                    <!-- Category Heading -->
                    <StackPanel Grid.Row="0" Margin="18,14,18,10">
                        <TextBlock Text="{Binding CurrentCategoryTitle}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding CurrentCategorySubtitle}"
                                   FontSize="10.8"
                                   Foreground="#8D98B0"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Animated Category ScrollViewer -->
                    <ScrollViewer x:Name="CategoryScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="18,0,18,12">
                        <Grid x:Name="CategoryContentHost">
                            <Grid.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Grid.RenderTransform>

                            <!-- ======================================================= -->
                            <!-- CATEGORY 0: GIAO DIỆN & VẬT LÝ                          -->
                            <!-- ======================================================= -->
                            <StackPanel Visibility="{Binding IsCat0AppearanceSelected, Converter={StaticResource BoolToVis}}">
                                <!-- Visual Preset Cards: Expanded Notch Size -->
                                <TextBlock Text="KÍCH THƯỚC KHUNG NOTCH KHI BUNG MỞ"
                                           FontSize="9.8"
                                           FontWeight="Bold"
                                           Foreground="#79849D"
                                           Margin="2,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PresetCompactCardBtn"
                                            Grid.Column="0"
                                            Command="{Binding SelectExpandedSizeCommand}"
                                            CommandParameter="Compact">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SequoiaPresetCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompactSizeSelected}" Value="True">
                                                        <Setter Property="Tag" Value="Selected" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Border Height="22" Background="#050507" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="0,0,7,7" Width="96" HorizontalAlignment="Left" Margin="0,0,0,7" />
                                            <TextBlock Text="Gọn chuẩn (Compact)" FontSize="11.8" FontWeight="SemiBold" Foreground="#F7F9FF" />
                                            <TextBlock Text="684 × 272 px • Tối ưu Laptop 13–15&quot;" FontSize="10.1" Foreground="#93A0BA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="PresetSpaciousCardBtn"
                                            Grid.Column="2"
                                            Command="{Binding SelectExpandedSizeCommand}"
                                            CommandParameter="Spacious">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SequoiaPresetCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpaciousSizeSelected}" Value="True">
                                                        <Setter Property="Tag" Value="Selected" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <Border Height="24" Background="#050507" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="0,0,8,8" Width="122" HorizontalAlignment="Left" Margin="0,0,0,5" />
                                            <TextBlock Text="Rộng thoáng (Spacious)" FontSize="11.8" FontWeight="SemiBold" Foreground="#F7F9FF" />
                                            <TextBlock Text="744 × 296 px • Thoáng đãng cho 2K/4K" FontSize="10.1" Foreground="#93A0BA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Visual Preset Cards: Spring Physics -->
                                <TextBlock Text="VẬT LÝ ĐÀN HỒI LÒ XO (SPRING PHYSICS 240HZ)"
                                           FontSize="9.8"
                                           FontWeight="Bold"
                                           Foreground="#79849D"
                                           Margin="2,0,0,6" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Command="{Binding SelectSpringPresetCardCommand}"
                                            CommandParameter="Balanced">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SequoiaPresetCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBalancedSpringSelected}" Value="True">
                                                        <Setter Property="Tag" Value="Selected" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="Cân bằng" FontSize="11.5" FontWeight="SemiBold" Foreground="#F7F9FF" />
                                            <TextBlock Text="Tự nhiên • 380/26" FontSize="9.9" Foreground="#93A0BA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Command="{Binding SelectSpringPresetCardCommand}"
                                            CommandParameter="Snappy">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SequoiaPresetCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSnappySpringSelected}" Value="True">
                                                        <Setter Property="Tag" Value="Selected" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="Nhanh sắc nét" FontSize="11.5" FontWeight="SemiBold" Foreground="#F7F9FF" />
                                            <TextBlock Text="Tức thì • 520/34" FontSize="9.9" Foreground="#93A0BA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Command="{Binding SelectSpringPresetCardCommand}"
                                            CommandParameter="Bouncy">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SequoiaPresetCardButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBouncySpringSelected}" Value="True">
                                                        <Setter Property="Tag" Value="Selected" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel>
                                            <TextBlock Text="Đàn hồi mềm" FontSize="11.5" FontWeight="SemiBold" Foreground="#F7F9FF" />
                                            <TextBlock Text="Sống động • 320/19" FontSize="9.9" Foreground="#93A0BA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Display, Delay & Startup Card -->
                                <Border Background="#151925"
                                        BorderBrush="#242B3E"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="13,11">
                                    <StackPanel>
                                        <TextBlock Text="Màn hình hiển thị Notch" FontSize="11.6" FontWeight="SemiBold" />
                                        <ComboBox Style="{StaticResource FluentDarkComboBox}"
                                                  ItemsSource="{Binding Monitors}"
                                                  SelectedValuePath="DeviceName"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding SelectedMonitorDevice}"
                                                  Margin="0,5,0,11"
                                                  Height="31" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Độ trễ giữ chuột để bung Notch (Chống lướt nhầm)"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding HoverExpandDelayMs, StringFormat={}{0} ms}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       Foreground="#93C5FD"
                                                       FontSize="11.2"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Slider Style="{StaticResource NotchSleekSlider}"
                                                Minimum="60"
                                                Maximum="450"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding HoverExpandDelayMs}"
                                                Margin="0,4,0,8" />

                                        <Separator Background="#22283A" Margin="0,4,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Khởi động cùng Windows" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Tự chạy nền nhẹ nhàng (~0% CPU) ngay khi đăng nhập máy" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================================================= -->
                            <!-- CATEGORY 1: TRUNG TÂM AI AGENTS                         -->
                            <!-- ======================================================= -->
                            <StackPanel Visibility="{Binding IsCat1AgentsSelected, Converter={StaticResource BoolToVis}}">
                                <Border Background="#151925"
                                        BorderBrush="#242B3E"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="14,11">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Tự động giám sát AI Agents thời gian thực (0% CPU khi rảnh)" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Tự bắt tín hiệu Antigravity CLI, Teamwork, Codex, Claude Code &amp; Named Pipe nội bộ" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableAgentMonitor}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="HUD Dynamic Island khi Agent Chờ duyệt / Hoàn tất" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Thả thẻ đen tuyền #050507 khi Agent cần phản hồi hoặc chạy xong • Nhấp để nhảy tới cửa sổ" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource NotchPillButton}"
                                                    Command="{Binding PreviewAgentHudCommand}"
                                                    Padding="10,4"
                                                    Margin="0,0,10,0"
                                                    FontSize="10.6"
                                                    VerticalAlignment="Center"
                                                    Content="Xem thử" />
                                            <CheckBox Grid.Column="2" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableAgentApprovalHud}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Đặt Tab 'Agents' làm Tab mở mặc định" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Hiển thị ngay cây Dự án &amp; Subagents (tự giãn chiều cao tới 2/3 màn hình) khi bung Notch" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding DefaultOpenAgentsTab}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================================================= -->
                            <!-- CATEGORY 2: TƯƠNG TÁC & CỬ CHỈ                          -->
                            <!-- ======================================================= -->
                            <StackPanel Visibility="{Binding IsCat2InteractionSelected, Converter={StaticResource BoolToVis}}">
                                <Border Background="#151925"
                                        BorderBrush="#242B3E"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="14,11">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Giữ phím Ctrl để bấm xuyên qua Notch (Ghost Mode)" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Làm mờ Notch còn 20% để bấm dễ dàng vào Tab trình duyệt bên dưới" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableCtrlGhostPassthrough}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Cử chỉ chuột trên thanh Notch thu gọn" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Lăn chuột chỉnh Âm lượng (Shift: Độ sáng) • Chuột giữa Play/Pause (Shift: Qua bài)" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableCollapsedScrollGestures}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Thay thế thanh Âm lượng gốc của Windows 11" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Bắt phím Media tăng/giảm âm lượng để hiện trực tiếp trên Notch" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding ReplaceSystemVolumeOsd}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Tự động ẩn khi xem Video / Chơi Game Fullscreen" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Tương thích chuẩn với chế độ Tự động ẩn Taskbar &amp; màn hình 125%/150% DPI" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableFullscreenHide}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================================================= -->
                            <!-- CATEGORY 3: THÔNG BÁO & DYNAMIC HUD                     -->
                            <!-- ======================================================= -->
                            <StackPanel Visibility="{Binding IsCat3HudSelected, Converter={StaticResource BoolToVis}}">
                                <Border Background="#151925"
                                        BorderBrush="#242B3E"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="14,10">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Hiệu ứng nhận thông báo Dynamic Island" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Thả thẻ thông báo đen tuyền chuẩn iOS • Nhấp để mở thẳng ứng dụng" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource NotchPillButton}"
                                                    Command="{Binding PreviewNotificationCommand}"
                                                    Padding="10,4"
                                                    Margin="0,0,10,0"
                                                    FontSize="10.5"
                                                    VerticalAlignment="Center"
                                                    Content="Xem thử" />
                                            <CheckBox Grid.Column="2" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableNotificationHud}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Ẩn nội dung tin nhắn trên thông báo (Chế độ thuyết trình)" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Chỉ hiện tên ứng dụng khi chia sẻ màn hình trực tuyến" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding HideNotificationPreviewText}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Tắt thông báo Notch khi Windows bật Không làm phiền" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Tắt mặc định để ẩn popup góc dưới Windows mà vẫn nhận thông báo qua Notch" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding RespectWindowsDoNotDisturb}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Hiệu ứng Face ID Dynamic Island khi mở khóa Windows" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Bung hoạt ảnh quét Face ID xanh lá ngay khi đăng nhập lại máy" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource NotchPillButton}"
                                                    Command="{Binding PreviewFaceIdCommand}"
                                                    Padding="10,4"
                                                    Margin="0,0,10,0"
                                                    FontSize="10.5"
                                                    VerticalAlignment="Center"
                                                    Content="Xem thử" />
                                            <CheckBox Grid.Column="2" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableUnlockFaceIdHud}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Thông báo HUD Sạc Pin &amp; Chuyển Bài Hát" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Bung nhanh thông báo khi cắm sạc, pin yếu hoặc qua bài nhạc mới" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableBatteryHud}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="HUD kết nối Loa &amp; Tai nghe (Kiểu AirPods)" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Thả thẻ đen tuyền kèm thanh mức âm lượng khi cắm/đổi thiết bị phát" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableAudioDeviceHud}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,7" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="HUD trạng thái phím Caps Lock" FontSize="11.6" FontWeight="SemiBold" />
                                                <TextBlock Text="Hiển thị viên thuốc HUD 1.35s báo BẬT / TẮT khi bấm phím Caps Lock" FontSize="10.2" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableCapsLockHud}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================================================= -->
                            <!-- CATEGORY 4: HỆ THỐNG & KHAY GIỮ FILE                    -->
                            <!-- ======================================================= -->
                            <StackPanel Visibility="{Binding IsCat4SystemShelfSelected, Converter={StaticResource BoolToVis}}">
                                <Border Background="#151925"
                                        BorderBrush="#242B3E"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Padding="14,11">
                                    <StackPanel>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Sóng nhạc FFT thời gian thực" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Chỉ chạy khi có trình phát nhạc đang Playing (0% CPU khi tạm dừng)" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnableFftVisualizer}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Chấm bảo mật Camera (Xanh) &amp; Micro (Cam)" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Cảnh báo ngay trên Notch khi có ứng dụng bật Webcam hoặc thu âm" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding EnablePrivacyDots}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Hiện tốc độ mạng (↓ MB/s) trên thanh Notch thu gọn" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Thay thế ngày ngắn bằng tốc độ tải xuống trực tiếp khi Notch đang rảnh" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding ShowCollapsedNetworkSpeed}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Background="#22283A" Margin="0,9" />

                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Tự động xóa file khỏi Khay sau khi kéo thả ra ngoài" FontSize="11.8" FontWeight="SemiBold" />
                                                <TextBlock Text="Tắt mặc định để bạn có thể kéo cùng 1 file sang nhiều ứng dụng liên tiếp" FontSize="10.3" Foreground="#8E96AA" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding AutoRemoveShelfItemAfterDrag}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Sticky Bottom Action Bar -->
                    <Border Grid.Row="2"
                            Background="#111520"
                            BorderBrush="#1CFFFFFF"
                            BorderThickness="0,1,0,0"
                            Padding="18,0,18,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource NotchPillButton}"
                                    Command="{Binding ResetDefaultsCommand}"
                                    Height="30"
                                    Padding="12,0"
                                    FontSize="11.2"
                                    Content="Khôi phục mặc định" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource NotchPillButton}"
                                    Command="{Binding CancelCommand}"
                                    Height="30"
                                    Margin="0,0,8,0"
                                    Padding="14,0"
                                    FontSize="11.2"
                                    Content="Đóng" />

                            <Button Grid.Column="3"
                                    Command="{Binding SaveAndCloseCommand}"
                                    Height="30"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Padding="16,0"
                                    FontSize="11.3"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <controls:SquircleBorder x:Name="SaveBd"
                                                                 CornerRadius="7.5"
                                                                 Background="#2563EB"
                                                                 BorderBrush="#3B82F6"
                                                                 BorderThickness="1"
                                                                 Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </controls:SquircleBorder>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SaveBd" Property="Background" Value="#3B82F6" />
                                                <Setter TargetName="SaveBd" Property="BorderBrush" Value="#60A5FA" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                Lưu thay đổi
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
