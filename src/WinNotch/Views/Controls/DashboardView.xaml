<UserControl x:Class="WinNotch.Views.Controls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls">

    <controls:SquircleBorder Background="{StaticResource FrostedCardBrush}"
                             BorderBrush="{StaticResource FrostedCardBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="14"
                             Padding="14,12,14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Sound Header + Active Output Device Pill + Volume Slider -->
            <StackPanel Grid.Row="0">
                <Grid Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Âm thanh"
                                   Foreground="#E8EEF9"
                                   FontSize="11.3"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />

                        <Ellipse Width="6.5"
                                 Height="6.5"
                                 Fill="{StaticResource PrivacyCamBrush}"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding CameraTooltip}"
                                 Visibility="{Binding IsCameraActive, Converter={StaticResource BoolToVis}}" />

                        <Ellipse Width="6.5"
                                 Height="6.5"
                                 Fill="{StaticResource PrivacyMicBrush}"
                                 Margin="4.5,0,0,0"
                                 VerticalAlignment="Center"
                                 ToolTip="{Binding MicrophoneTooltip}"
                                 Visibility="{Binding IsMicrophoneActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource NotchGhostButton}"
                            Command="{Binding CycleAudioOutputCommand}"
                            PreviewMouseRightButtonUp="OnAudioDeviceRightClick"
                            Height="20"
                            Padding="6,0"
                            ToolTip="Click trái: Đổi Loa / Tai nghe 1 chạm&#x0a;Click phải: Cài đặt Âm thanh Windows">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:IconsaxIcon Kind="{Binding OutputDeviceIcon}"
                                                  Size="11.5"
                                                  Foreground="#93C5FD"
                                                  Margin="0,0,4.5,0"
                                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding OutputDeviceName}"
                                       Foreground="#B4BED4"
                                       FontSize="10.4"
                                       FontWeight="Medium"
                                       MaxWidth="168"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Interactive Volume Slider (Supports Wheel + Click-to-Seek + Drag) -->
                <Grid Margin="0,4,0,0" Height="22" PreviewMouseWheel="OnVolumeWheel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource NotchGhostButton}"
                            Command="{Binding ToggleMuteCommand}"
                            Width="26"
                            Height="22"
                            Padding="0"
                            ToolTip="Bật / Tắt tiếng">
                        <controls:IconsaxIcon Kind="{Binding VolumeIcon}" Size="15.5" />
                    </Button>

                    <Slider Grid.Column="1"
                            Style="{StaticResource NotchSleekSlider}"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding QuickVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Margin="7,0"
                            PreviewMouseLeftButtonDown="OnQuickSliderDown"
                            PreviewMouseLeftButtonUp="OnQuickSliderUp" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding QuickVolumePercent, StringFormat={}{0:0}%}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="11"
                               FontWeight="Medium"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Row 1: Display Brightness Slider (Permanent Control Center Module) -->
            <Grid Grid.Row="1" Margin="0,8,0,0" Height="22" PreviewMouseWheel="OnBrightnessWheel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <controls:IconsaxIcon Grid.Column="0"
                                      Kind="Sun1"
                                      Size="15.5"
                                      Foreground="#FFD60A"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />

                <Slider Grid.Column="1"
                        Style="{StaticResource NotchSleekSlider}"
                        Minimum="0"
                        Maximum="100"
                        IsEnabled="{Binding IsBrightnessSupported}"
                        Value="{Binding QuickBrightnessPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Foreground="#FFD60A"
                        Margin="7,0"
                        PreviewMouseLeftButtonDown="OnQuickSliderDown"
                        PreviewMouseLeftButtonUp="OnQuickSliderUp" />

                <TextBlock Grid.Column="2"
                           Text="{Binding QuickBrightnessPercent, StringFormat={}{0:0}%}"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="11"
                           FontWeight="Medium"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Row 2: Compact 1-Row Control Center Quick Timer Module -->
            <controls:SquircleBorder Grid.Row="2"
                                     Margin="0,10,0,0"
                                     CornerRadius="9.5"
                                     BorderThickness="1"
                                     Padding="10,6"
                                     PreviewMouseWheel="OnTimerWheel"
                                     ToolTip="Lăn chuột để tăng/giảm ±1 phút">
                <controls:SquircleBorder.Style>
                    <Style TargetType="controls:SquircleBorder">
                        <Setter Property="Background" Value="#15FFFFFF" />
                        <Setter Property="BorderBrush" Value="#1DFFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCollapsedTimerPill}" Value="True">
                                <Setter Property="Background" Value="#1AFF9F0A" />
                                <Setter Property="BorderBrush" Value="#42FF9F0A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:SquircleBorder.Style>

                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Countdown Readout -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Timer"
                                              Size="14"
                                              Foreground="#FFB84D"
                                              Margin="0,0,5.5,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TimerDisplayText}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12.8"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Inline Presets (5p / 15p / 25p) + Play/Pause + Reset -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NotchPillButton}"
                                Command="{Binding StartTimer5Command}"
                                Width="29"
                                Height="22"
                                Padding="0"
                                FontSize="10.4"
                                ToolTip="Hẹn giờ nhanh 5 phút"
                                Content="5p" />
                        <Button Style="{StaticResource NotchPillButton}"
                                Command="{Binding StartTimer15Command}"
                                Width="31"
                                Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                FontSize="10.4"
                                ToolTip="Hẹn giờ nhanh 15 phút"
                                Content="15p" />
                        <Button Style="{StaticResource NotchPillButton}"
                                Command="{Binding StartTimer25Command}"
                                Width="31"
                                Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                FontSize="10.4"
                                ToolTip="Pomodoro 25 phút"
                                Content="25p" />

                        <Button Style="{StaticResource NotchGhostButton}"
                                Command="{Binding ToggleTimerPauseCommand}"
                                Width="25"
                                Height="22"
                                Margin="5,0,0,0"
                                Padding="0"
                                ToolTip="Bắt đầu / Tạm dừng">
                            <controls:IconsaxIcon Kind="{Binding TimerToggleIcon}" Size="12" />
                        </Button>
                        <Button Style="{StaticResource NotchGhostButton}"
                                Command="{Binding ResetTimerCommand}"
                                Width="24"
                                Height="22"
                                Margin="2,0,0,0"
                                Padding="0"
                                ToolTip="Đặt lại đồng hồ">
                            <controls:IconsaxIcon Kind="Reset" Size="12.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </controls:SquircleBorder>

            <!-- Row 3: 4 Balanced Control Center Quick Action Tiles (Height=33) -->
            <Grid Grid.Row="3" Height="33" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Caffeine Mode -->
                <Button Grid.Column="0"
                        Command="{Binding ToggleCaffeineCommand}"
                        Padding="4,0"
                        ToolTip="Giữ màn hình luôn sáng, chống ngủ máy (Caffeine)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NotchPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCaffeineActive}" Value="True">
                                    <Setter Property="Background" Value="#26F59E0B" />
                                    <Setter Property="BorderBrush" Value="#4DF59E0B" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Coffee"
                                              Size="12.5"
                                              Foreground="#F59E0B"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="Giữ sáng"
                                   FontSize="10.6"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 2. System-wide Microphone Toggle -->
                <Button Grid.Column="2"
                        Command="{Binding ToggleMicMuteCommand}"
                        Padding="4,0"
                        ToolTip="Bật / Tắt Micro toàn hệ thống (Alt + M)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NotchPillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                    <Setter Property="Background" Value="#2BFF453A" />
                                    <Setter Property="BorderBrush" Value="#52FF453A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Size="12.5"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center">
                            <controls:IconsaxIcon.Style>
                                <Style TargetType="controls:IconsaxIcon">
                                    <Setter Property="Kind" Value="Microphone" />
                                    <Setter Property="Foreground" Value="#30D158" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                            <Setter Property="Kind" Value="MicrophoneSlash" />
                                            <Setter Property="Foreground" Value="#FF453A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:IconsaxIcon.Style>
                        </controls:IconsaxIcon>
                        <TextBlock FontSize="10.6"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Micro" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicMuted}" Value="True">
                                            <Setter Property="Text" Value="Tắt Mic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <!-- 3. Screen Color Picker -->
                <Button Grid.Column="4"
                        Style="{StaticResource NotchPillButton}"
                        Command="{Binding StartColorPickerCommand}"
                        Padding="4,0"
                        ToolTip="Chấm mã màu màn hình #HEX (Alt + C)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Colorfilter"
                                              Size="12.5"
                                              Foreground="#C084FC"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="Chấm màu"
                                   FontSize="10.6"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 4. Screen Snip -->
                <Button Grid.Column="6"
                        Style="{StaticResource NotchPillButton}"
                        Command="{Binding TriggerScreenSnipCommand}"
                        Padding="4,0"
                        ToolTip="Thu gọn Notch &amp; chụp vùng màn hình (Win + Shift + S)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Scan"
                                              Size="12.5"
                                              Foreground="#34D399"
                                              Margin="0,0,4.5,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="Chụp vùng"
                                   FontSize="10.6"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
