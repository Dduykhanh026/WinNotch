<UserControl x:Class="WinNotch.Views.Controls.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls"
             Focusable="True"
             PreviewKeyDown="OnShelfPreviewKeyDown">

    <controls:SquircleBorder Background="{StaticResource FrostedCardBrush}"
                             BorderBrush="{StaticResource FrostedCardBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="14"
                             Padding="15,13,15,13">
        <Grid>
            <!-- Empty Shelf Prompt -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsShelfEmpty, Converter={StaticResource BoolToVis}}">
                <controls:IconsaxIcon Kind="ImportTray"
                                      Size="26"
                                      Foreground="#60A5FA"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,7" />
                <TextBlock Text="Khay giữ file tạm thời đang trống"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Kéo File, Thư mục, Ảnh hoặc Đoạn chữ vào đỉnh màn hình để cất tạm và thả sang nhiều ứng dụng"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11.2"
                           FontWeight="Regular"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="460" />

                <Button Style="{StaticResource NotchPillButton}"
                        Command="{Binding PasteShelfFromClipboardCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Padding="12,5"
                        ToolTip="Dán ảnh chụp, file hoặc văn bản từ Clipboard vào khay (Ctrl + V)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Add"
                                              Size="13"
                                              Foreground="#60A5FA"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="+ Dán từ Clipboard"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Populated Shelf Items + Footer -->
            <Grid Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ShelfScroller"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnShelfMouseWheel">
                    <ItemsControl ItemsSource="{Binding ShelfItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SquircleBorder Width="142"
                                                         Background="#18FFFFFF"
                                                         BorderBrush="#26FFFFFF"
                                                         BorderThickness="1"
                                                         CornerRadius="10"
                                                         Margin="0,3,10,0"
                                                         Padding="11,8"
                                                         Cursor="Hand"
                                                         RenderTransformOrigin="0.5,0.5"
                                                         ToolTipService.InitialShowDelay="260"
                                                         Loaded="OnItemCardLoaded"
                                                         MouseEnter="OnItemCardMouseEnter"
                                                         MouseLeave="OnItemCardMouseLeave"
                                                         MouseLeftButtonDown="OnItemCardMouseDown"
                                                         MouseMove="OnItemCardMouseMove">
                                    <controls:SquircleBorder.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                            <TranslateTransform Y="0" />
                                        </TransformGroup>
                                    </controls:SquircleBorder.RenderTransform>

                                    <!-- Rich Quick-Look Frosted Dark Preview Card -->
                                    <controls:SquircleBorder.ToolTip>
                                        <ToolTip Background="#0D1017"
                                                 BorderBrush="#2CFFFFFF"
                                                 BorderThickness="1"
                                                 Padding="10,8"
                                                 MaxWidth="252">
                                            <StackPanel>
                                                <!-- Crisp Image Preview (Up to 168x112) -->
                                                <Border CornerRadius="6.5"
                                                        Background="#14FFFFFF"
                                                        BorderBrush="#24FFFFFF"
                                                        BorderThickness="1"
                                                        Padding="3"
                                                        Margin="0,0,0,7"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasImagePreview, Converter={StaticResource BoolToVis}}">
                                                    <Image Source="{Binding Thumbnail}"
                                                           MaxWidth="168"
                                                           MaxHeight="112"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <!-- Multi-line Text / URL Snippet Preview -->
                                                <Border CornerRadius="6"
                                                        Background="#14FFFFFF"
                                                        BorderBrush="#22FFFFFF"
                                                        BorderThickness="1"
                                                        Padding="7,5"
                                                        Margin="0,0,0,7"
                                                        Visibility="{Binding HasTextSnippetPreview, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PreviewSnippetText}"
                                                               Foreground="#DCE4F5"
                                                               FontSize="10.4"
                                                               MaxHeight="72"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>

                                                <!-- Header: Kind Badge + Display Name -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border CornerRadius="4"
                                                            Background="#223B82F6"
                                                            BorderBrush="#3E60A5FA"
                                                            BorderThickness="1"
                                                            Padding="5,1"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding KindBadgeText}"
                                                                   Foreground="#93C5FD"
                                                                   FontSize="9.3"
                                                                   FontWeight="SemiBold" />
                                                    </Border>

                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="#F7F8FC"
                                                               FontSize="11.2"
                                                               FontWeight="SemiBold"
                                                               MaxWidth="168"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding SubLabel}"
                                                           Foreground="#9AA6BE"
                                                           FontSize="10.1"
                                                           Margin="0,3,0,0" />

                                                <TextBlock Text="{Binding FilePath}"
                                                           Foreground="#6F7C96"
                                                           FontSize="9.6"
                                                           Margin="0,3,0,0"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="34"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasFilePathLine, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </controls:SquircleBorder.ToolTip>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- True G2 Continuous Apple Squircle Thumbnail (44x44, r=9.8 ~22%) -->
                                        <Grid Grid.Row="0"
                                              Width="44"
                                              Height="44"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <controls:SquircleBorder CornerRadius="9.8"
                                                                     Background="#18FFFFFF"
                                                                     BorderBrush="#24FFFFFF"
                                                                     BorderThickness="0.8"
                                                                     Visibility="{Binding Thumbnail, Converter={StaticResource NullToInvVis}}">
                                                <controls:IconsaxIcon Kind="{Binding FallbackIcon}"
                                                                      Size="20"
                                                                      Foreground="#93C5FD"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                            </controls:SquircleBorder>

                                            <controls:SquircleBorder CornerRadius="9.8"
                                                                     BorderBrush="#30FFFFFF"
                                                                     BorderThickness="0.8"
                                                                     RenderOptions.BitmapScalingMode="HighQuality"
                                                                     Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}">
                                                <controls:SquircleBorder.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                                </controls:SquircleBorder.Background>
                                            </controls:SquircleBorder>
                                        </Grid>

                                        <!-- Top-Right Squircle Iconsax Reveal + Copy + Remove Actions -->
                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                            <Button Style="{StaticResource NotchGhostButton}"
                                                    Command="{Binding DataContext.RevealShelfItemInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    ToolTip="Hiện vị trí trong Windows Explorer">
                                                <controls:IconsaxIcon Kind="Folder2" Size="12" Foreground="#D4DCF0" />
                                            </Button>
                                            <Button Style="{StaticResource NotchGhostButton}"
                                                    Command="{Binding DataContext.CopyShelfItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    ToolTip="Sao chép vào Clipboard">
                                                <controls:IconsaxIcon Kind="Copy" Size="12" Foreground="#D4DCF0" />
                                            </Button>
                                            <Button Style="{StaticResource NotchGhostButton}"
                                                    Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    ToolTip="Xóa khỏi khay">
                                                <controls:IconsaxIcon Kind="Close" Size="11" Foreground="#D4DCF0" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Display Name -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Size / Type Label -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SubLabel}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10.3"
                                                   FontWeight="Regular"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </controls:SquircleBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer Bar: Paste, Drag All & Clear All -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource NotchPillButton}"
                                Command="{Binding PasteShelfFromClipboardCommand}"
                                Padding="9,4.5"
                                Margin="0,0,8,0"
                                ToolTip="Dán ảnh chụp, file hoặc văn bản từ Clipboard (Ctrl + V)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:IconsaxIcon Kind="Add"
                                                      Size="12.5"
                                                      Foreground="#60A5FA"
                                                      Margin="0,0,5,0"
                                                      VerticalAlignment="Center" />
                                <TextBlock Text="+ Dán từ Clipboard"
                                           FontSize="11.3"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <controls:SquircleBorder Background="#283B82F6"
                                                 BorderBrush="#5E3B82F6"
                                                 BorderThickness="1"
                                                 CornerRadius="7"
                                                 Padding="11,5"
                                                 Cursor="Hand"
                                                 ToolTip="Nhấn giữ và kéo nút này để thả toàn bộ file sang ứng dụng khác"
                                                 MouseLeftButtonDown="OnDragAllMouseDown"
                                                 MouseMove="OnDragAllMouseMove">
                            <StackPanel Orientation="Horizontal">
                                <controls:IconsaxIcon Kind="ExportTray"
                                                      Size="14"
                                                      Foreground="#EAF2FF"
                                                      Margin="0,0,6.5,0"
                                                      VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DragAllButtonText}"
                                           Foreground="#EAF2FF"
                                           FontSize="11.3"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </controls:SquircleBorder>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Nhấp đúp để mở • Nhấn giữ thẻ để kéo ra ngoài"
                               Foreground="#88FFFFFF"
                               FontSize="10.6"
                               FontWeight="Regular"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Style="{StaticResource NotchPillButton}"
                            Command="{Binding ClearShelfCommand}"
                            Padding="10,4.5">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconsaxIcon Kind="Trash"
                                                  Size="13.5"
                                                  Foreground="#FCA5A5"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center" />
                            <TextBlock Text="Xóa hết"
                                       FontSize="11.3"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
