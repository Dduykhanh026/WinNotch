<UserControl x:Class="WinNotch.Views.Controls.ShelfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls">

    <controls:SquircleBorder Background="{StaticResource FrostedCardBrush}"
                             BorderBrush="{StaticResource FrostedCardBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="14"
                             Padding="15,13,15,13">
        <Grid>
            <!-- Empty Shelf Prompt -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsShelfEmpty, Converter={StaticResource BoolToVis}}">
                <controls:IconsaxIcon Kind="ImportTray"
                                      Size="26"
                                      Foreground="#60A5FA"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,7" />
                <TextBlock Text="Khay giữ file tạm thời đang trống"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Kéo File, Thư mục, Ảnh hoặc Đoạn chữ vào đỉnh màn hình để cất tạm và thả sang nhiều ứng dụng"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11.2"
                           FontWeight="Regular"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="460" />
            </StackPanel>

            <!-- Populated Shelf Items + Footer -->
            <Grid Visibility="{Binding HasShelfItems, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ShelfScroller"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnShelfMouseWheel">
                    <ItemsControl ItemsSource="{Binding ShelfItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:SquircleBorder Width="142"
                                                         Background="#18FFFFFF"
                                                         BorderBrush="#26FFFFFF"
                                                         BorderThickness="1"
                                                         CornerRadius="10"
                                                         Margin="0,0,10,0"
                                                         Padding="11,8"
                                                         Cursor="Hand"
                                                         ToolTip="{Binding FilePath}"
                                                         MouseLeftButtonDown="OnItemCardMouseDown"
                                                         MouseMove="OnItemCardMouseMove">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- True G2 Continuous Apple Squircle Thumbnail (44x44, r=9.8 ~22%) -->
                                        <Grid Grid.Row="0"
                                              Width="44"
                                              Height="44"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                            <controls:SquircleBorder CornerRadius="9.8"
                                                                     Background="#18FFFFFF"
                                                                     BorderBrush="#24FFFFFF"
                                                                     BorderThickness="0.8"
                                                                     Visibility="{Binding Thumbnail, Converter={StaticResource NullToInvVis}}">
                                                <controls:IconsaxIcon Kind="{Binding FallbackIcon}"
                                                                      Size="20"
                                                                      Foreground="#93C5FD"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                            </controls:SquircleBorder>

                                            <controls:SquircleBorder CornerRadius="9.8"
                                                                     BorderBrush="#30FFFFFF"
                                                                     BorderThickness="0.8"
                                                                     RenderOptions.BitmapScalingMode="HighQuality"
                                                                     Visibility="{Binding Thumbnail, Converter={StaticResource NullToVis}}">
                                                <controls:SquircleBorder.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                                </controls:SquircleBorder.Background>
                                            </controls:SquircleBorder>
                                        </Grid>

                                        <!-- Top-Right Squircle Iconsax Copy + Remove Actions -->
                                        <StackPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                            <Button Style="{StaticResource NotchGhostButton}"
                                                    Command="{Binding DataContext.CopyShelfItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24"
                                                    Height="24"
                                                    Padding="0"
                                                    ToolTip="Sao chép vào Clipboard">
                                                <controls:IconsaxIcon Kind="Copy" Size="12.5" Foreground="#D4DCF0" />
                                            </Button>
                                            <Button Style="{StaticResource NotchGhostButton}"
                                                    Command="{Binding DataContext.RemoveShelfItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    ToolTip="Xóa khỏi khay">
                                                <controls:IconsaxIcon Kind="Close" Size="11.5" Foreground="#D4DCF0" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Display Name -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding DisplayName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11.5"
                                                   FontWeight="Medium"
                                                   Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Size / Type Label -->
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SubLabel}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="10.3"
                                                   FontWeight="Regular"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </controls:SquircleBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer Bar: Drag All & Clear All -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SquircleBorder Grid.Column="0"
                                             Background="#283B82F6"
                                             BorderBrush="#5E3B82F6"
                                             BorderThickness="1"
                                             CornerRadius="7"
                                             Padding="11,5"
                                             Cursor="Hand"
                                             ToolTip="Nhấn giữ và kéo nút này để thả toàn bộ file sang ứng dụng khác"
                                             MouseLeftButtonDown="OnDragAllMouseDown"
                                             MouseMove="OnDragAllMouseMove">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconsaxIcon Kind="ExportTray"
                                                  Size="14"
                                                  Foreground="#EAF2FF"
                                                  Margin="0,0,6.5,0"
                                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DragAllButtonText}"
                                       Foreground="#EAF2FF"
                                       FontSize="11.3"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </controls:SquircleBorder>

                    <TextBlock Grid.Column="1"
                               Text="Nhấn giữ thẻ để kéo ra ngoài (hỗ trợ kéo thả nhiều lần)"
                               Foreground="#88FFFFFF"
                               FontSize="10.8"
                               FontWeight="Regular"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Grid.Column="2"
                            Style="{StaticResource NotchPillButton}"
                            Command="{Binding ClearShelfCommand}"
                            Padding="10,4.5">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconsaxIcon Kind="Trash"
                                                  Size="13.5"
                                                  Foreground="#FCA5A5"
                                                  Margin="0,0,5.5,0"
                                                  VerticalAlignment="Center" />
                            <TextBlock Text="Xóa hết"
                                       FontSize="11.3"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
