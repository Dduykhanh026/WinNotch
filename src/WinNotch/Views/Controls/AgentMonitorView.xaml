<UserControl x:Class="WinNotch.Views.Controls.AgentMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls">

    <!-- =========================================================================== -->
    <!-- SINGLE-COLUMN FULL-WIDTH PROJECT TREE (Dynamic Height up to 2/3 Screen)     -->
    <!-- Columns: [Tên Dự Án / Subagent] — [Công việc] — [Tiến độ %] — [Thời gian]   -->
    <!-- =========================================================================== -->
    <controls:SquircleBorder x:Name="AgentSingleColumnCard"
                             Background="{StaticResource FrostedCardBrush}"
                             BorderBrush="{StaticResource FrostedCardBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="14"
                             Padding="13,10,13,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- =================================================================== -->
            <!-- ROW 0: COMPACT TOP TOOLBAR (Live Summary + Filter Pills + Actions)  -->
            <!-- =================================================================== -->
            <Grid Grid.Row="0" Height="27" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Icon + Swarm Summary + Segmented Filter (Tất cả | Đang chạy) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:SquircleBorder Width="23"
                                             Height="23"
                                             CornerRadius="6"
                                             Background="#1A3B82F6"
                                             BorderBrush="#3460A5FA"
                                             BorderThickness="1"
                                             Margin="0,0,7,0">
                        <controls:IconsaxIcon Kind="Hierarchy"
                                              Size="12.5"
                                              Foreground="#93C5FD"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                    </controls:SquircleBorder>

                    <TextBlock Text="{Binding AgentSwarmSummaryText}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#DCE4F5"
                               FontSize="11"
                               FontWeight="SemiBold"
                               MaxWidth="215"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <!-- Filter Pills -->
                    <controls:SquircleBorder CornerRadius="6.5"
                                             Background="#10FFFFFF"
                                             BorderBrush="#1EFFFFFF"
                                             BorderThickness="1"
                                             Padding="2"
                                             Margin="9,0,0,0"
                                             VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SelectAllAgentsFilterCommand}"
                                    Cursor="Hand"
                                    Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <controls:SquircleBorder x:Name="PillBd"
                                                                 CornerRadius="5"
                                                                 Background="Transparent"
                                                                 Padding="7,2.5">
                                            <TextBlock x:Name="PillTxt"
                                                       Text="Tất cả"
                                                       Foreground="#94A0B8"
                                                       FontSize="10"
                                                       FontWeight="Medium" />
                                        </controls:SquircleBorder>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAllAgentsFilterSelected}" Value="True">
                                                <Setter TargetName="PillBd" Property="Background" Value="#28FFFFFF" />
                                                <Setter TargetName="PillTxt" Property="Foreground" Value="#F7F9FF" />
                                                <Setter TargetName="PillTxt" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding SelectActiveAgentsFilterCommand}"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Margin="2,0,0,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <controls:SquircleBorder x:Name="PillBd"
                                                                 CornerRadius="5"
                                                                 Background="Transparent"
                                                                 Padding="7,2.5">
                                            <TextBlock x:Name="PillTxt"
                                                       Text="Đang chạy"
                                                       Foreground="#94A0B8"
                                                       FontSize="10"
                                                       FontWeight="Medium" />
                                        </controls:SquircleBorder>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActiveAgentsFilterSelected}" Value="True">
                                                <Setter TargetName="PillBd" Property="Background" Value="#2A3B82F6" />
                                                <Setter TargetName="PillTxt" Property="Foreground" Value="#93C5FD" />
                                                <Setter TargetName="PillTxt" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </controls:SquircleBorder>
                </StackPanel>

                <!-- Right: Quick Actions (Mở cửa sổ | Chép Hook | Dọn xong) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NotchPillButton}"
                            Command="{Binding FocusPrimaryAgentCommand}"
                            Height="25"
                            Padding="8.5,0"
                            ToolTip="Đưa cửa sổ Terminal / IDE chứa Agent chính lên trên cùng">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:IconsaxIcon Kind="ExportTray"
                                                  Size="11"
                                                  Foreground="#93C5FD"
                                                  Margin="0,0,4.5,0"
                                                  VerticalAlignment="Center" />
                            <TextBlock Text="Mở cửa sổ"
                                       FontSize="10.3"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NotchPillButton}"
                            Command="{Binding CopyAgentHookCommand}"
                            Height="25"
                            Padding="8,0"
                            Margin="5,0,0,0"
                            ToolTip="Sao chép cấu hình .agents/hooks.json mẫu vào Clipboard">
                        <TextBlock Text="{Binding AgentHookButtonText}"
                                   FontSize="10.2"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Button>

                    <Button Style="{StaticResource NotchPillButton}"
                            Command="{Binding ClearCompletedAgentsCommand}"
                            Height="25"
                            Padding="8,0"
                            Margin="5,0,0,0"
                            ToolTip="Ẩn các phiên đã hoàn tất khỏi danh sách">
                        <TextBlock Text="Dọn xong"
                                   FontSize="10.2"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- =================================================================== -->
            <!-- ROW 1A: STANDBY / EMPTY STATE (0 recent sessions)                   -->
            <!-- =================================================================== -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasAnyAgents, Converter={StaticResource InvBoolToVis}}">
                <controls:SquircleBorder Width="42"
                                         Height="42"
                                         CornerRadius="10.5"
                                         Background="#163B82F6"
                                         BorderBrush="#2E60A5FA"
                                         BorderThickness="1"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8">
                    <controls:IconsaxIcon Kind="Bot"
                                          Size="20"
                                          Foreground="#93C5FD"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                </controls:SquircleBorder>

                <TextBlock Text="Sẵn sàng giám sát AI Agents theo Dự án"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12.6"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Tự động hiển thị [Tên Dự Án] — [Công việc đang làm] — [Tiến độ %] — [Thời gian chạy] từ Antigravity, Teamwork, Codex &amp; Claude Code (~0% CPU khi rảnh)"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10.6"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="470"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- =================================================================== -->
            <!-- ROW 1B: FILTERED EMPTY HINT (No active runs while "Đang chạy" on)   -->
            <!-- =================================================================== -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptyFilteredAgentsHint, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Hiện không có Agent nào đang chạy"
                           Foreground="#DCE4F5"
                           FontSize="11.8"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Chuyển bộ lọc sang &quot;Tất cả&quot; để xem các phiên vừa hoàn tất gần đây."
                           Foreground="#8B96AE"
                           FontSize="10.5"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- =================================================================== -->
            <!-- ROW 1C: 4-COLUMN PARENT-CHILD PROJECT TREE STREAM                   -->
            <!-- =================================================================== -->
            <ScrollViewer x:Name="AgentTreeScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnAgentStreamWheel"
                          Visibility="{Binding HasFilteredAgentSessions, Converter={StaticResource BoolToVis}}">
                <ItemsControl x:Name="AgentProjectTreeItems"
                              ItemsSource="{Binding FilteredAgentSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RowHost" Margin="0,0,0,6">
                                <!-- Full-Width Clickable Row Card -->
                                <Button Command="{Binding DataContext.FocusAgentSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SessionId}"
                                        Cursor="Hand"
                                        Focusable="False"
                                        ToolTip="Nhấp để mở nhanh cửa sổ Terminal / IDE của Agent này">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <controls:SquircleBorder x:Name="RowBd"
                                                                     CornerRadius="9"
                                                                     Background="#17FFFFFF"
                                                                     BorderBrush="#25FFFFFF"
                                                                     BorderThickness="1"
                                                                     Padding="10,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Col 0: [Tên Dự Án] or └─ [Vai trò Subagent] -->
                                                        <ColumnDefinition Width="196" />
                                                        <!-- Col 1: [Công việc mà agent đang làm] -->
                                                        <ColumnDefinition Width="*" />
                                                        <!-- Col 2: [Tiến độ % + 54px Capsule Bar] -->
                                                        <ColumnDefinition Width="104" />
                                                        <!-- Col 3: [Thời gian chạy mm:ss] -->
                                                        <ColumnDefinition Width="56" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- COLUMN 0: Project Name (Parent) or Indented Subagent Role (Child) -->
                                                    <StackPanel Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <!-- Spacer reserved for clickable expand/collapse chevron on parent rows with children -->
                                                        <Border Width="16"
                                                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" />

                                                        <!-- Tree L-connector on child subagent rows -->
                                                        <Path Data="M 1,0 L 1,7 L 8,7"
                                                              Stroke="#5C6985"
                                                              StrokeThickness="1.35"
                                                              Width="10"
                                                              Height="10"
                                                              Margin="0,0,4,0"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsSubagent, Converter={StaticResource BoolToVis}}" />

                                                        <!-- Living Breathing Status Dot (0% CPU when Completed) -->
                                                        <Control Style="{StaticResource BreathingStatusDotStyle}"
                                                                 Foreground="{Binding StatusDotBrush}"
                                                                 IsEnabled="{Binding IsActive}"
                                                                 Margin="0,0,5.5,0"
                                                                 VerticalAlignment="Center" />

                                                        <!-- Primary Label: Real Project Name or Subagent Role -->
                                                        <TextBlock x:Name="PrimaryLabelTxt"
                                                                   Text="{Binding PrimaryRowLabel}"
                                                                   ToolTip="{Binding PrimaryRowLabel}"
                                                                   Foreground="#F8FAFF"
                                                                   FontSize="11.6"
                                                                   FontWeight="SemiBold"
                                                                   MaxWidth="136"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Child count pill on parent rows -->
                                                        <controls:SquircleBorder CornerRadius="4.5"
                                                                                 Background="#1A60A5FA"
                                                                                 BorderBrush="#3260A5FA"
                                                                                 BorderThickness="1"
                                                                                 Padding="4.5,1"
                                                                                 Margin="5,0,0,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding SubCountBadgeText}"
                                                                       Typography.NumeralAlignment="Tabular"
                                                                       Foreground="#93C5FD"
                                                                       FontSize="9.2"
                                                                       FontWeight="SemiBold" />
                                                        </controls:SquircleBorder>
                                                    </StackPanel>

                                                    <!-- COLUMN 1: Current Vietnamese Action / Task -->
                                                    <TextBlock x:Name="ActionTxt"
                                                               Grid.Column="1"
                                                               Text="{Binding CurrentActionText}"
                                                               ToolTip="{Binding CurrentActionText}"
                                                               Foreground="#CED7EA"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Margin="10,0,10,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <!-- COLUMN 2: Inline 54px Capsule Progress Bar + Tabular % -->
                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="54" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0"
                                                                Width="54"
                                                                Height="4.8"
                                                                CornerRadius="2.4"
                                                                Background="#22FFFFFF"
                                                                VerticalAlignment="Center">
                                                            <Border Width="{Binding ProgressBarFillWidth}"
                                                                    Height="4.8"
                                                                    CornerRadius="2.4"
                                                                    Background="{Binding ProgressBarBrush}"
                                                                    HorizontalAlignment="Left" />
                                                        </Border>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ProgressText}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{Binding StatusTextBrush}"
                                                                   FontSize="10.4"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- COLUMN 3: Live Per-Turn Stopwatch (mm:ss) -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding RuntimeText}"
                                                               Typography.NumeralAlignment="Tabular"
                                                               Foreground="#97A4BE"
                                                               FontSize="10.6"
                                                               FontWeight="Medium"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </controls:SquircleBorder>

                                            <ControlTemplate.Triggers>
                                                <!-- Indented Child Subagent Row Presentation -->
                                                <DataTrigger Binding="{Binding IsSubagent}" Value="True">
                                                    <Setter TargetName="RowBd" Property="CornerRadius" Value="7.5" />
                                                    <Setter TargetName="RowBd" Property="Background" Value="#10FFFFFF" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#1AFFFFFF" />
                                                    <Setter TargetName="RowBd" Property="Padding" Value="9,5" />
                                                    <Setter TargetName="PrimaryLabelTxt" Property="FontSize" Value="10.8" />
                                                    <Setter TargetName="PrimaryLabelTxt" Property="FontWeight" Value="Medium" />
                                                    <Setter TargetName="PrimaryLabelTxt" Property="Foreground" Value="#DCE4F5" />
                                                    <Setter TargetName="PrimaryLabelTxt" Property="MaxWidth" Value="144" />
                                                    <Setter TargetName="ActionTxt" Property="FontSize" Value="10.4" />
                                                    <Setter TargetName="ActionTxt" Property="Foreground" Value="#AAB5CC" />
                                                </DataTrigger>

                                                <!-- Hover Highlight -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#24FFFFFF" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#38FFFFFF" />
                                                </Trigger>

                                                <!-- Waiting Approval Amber Highlight -->
                                                <DataTrigger Binding="{Binding IsWaitingApproval}" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1FF59E0B" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#52FBBF24" />
                                                    <Setter TargetName="ActionTxt" Property="Foreground" Value="#FDE68A" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Overlay Expand/Collapse Chevron Button on Parent Rows with Subagents -->
                                <Button Command="{Binding DataContext.ToggleAgentGroupExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding GroupId}"
                                        Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                        Width="20"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="6,0,0,0"
                                        Cursor="Hand"
                                        Focusable="False"
                                        ToolTip="Thu gọn / Mở rộng danh sách Subagents của dự án">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ChevBd"
                                                    Background="Transparent"
                                                    CornerRadius="4">
                                                <TextBlock Text="{Binding ExpandChevron}"
                                                           Foreground="#9CB0D4"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ChevBd" Property="Background" Value="#28FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSubagent}" Value="True">
                                    <Setter TargetName="RowHost" Property="Margin" Value="20,0,0,4.5" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
