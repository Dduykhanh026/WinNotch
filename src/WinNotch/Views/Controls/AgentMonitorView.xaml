<UserControl x:Class="WinNotch.Views.Controls.AgentMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ======================================================================= -->
        <!-- CARD 1 (LEFT): PRIMARY AGENT / SWARM FOCUS & QUICK CONTROLS             -->
        <!-- ======================================================================= -->
        <controls:SquircleBorder Grid.Column="0"
                                 Background="{StaticResource FrostedCardBrush}"
                                 BorderBrush="{StaticResource FrostedCardBorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="14"
                                 Padding="14,12,14,12">
            <Grid>
                <!-- Empty / Standby State when 0 recent sessions exist -->
                <Grid Visibility="{Binding HasAnyAgents, Converter={StaticResource InvBoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <controls:SquircleBorder Width="42"
                                                 Height="42"
                                                 CornerRadius="10.5"
                                                 Background="#163B82F6"
                                                 BorderBrush="#2E60A5FA"
                                                 BorderThickness="1"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,8">
                            <controls:IconsaxIcon Kind="Bot"
                                                  Size="20"
                                                  Foreground="#93C5FD"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </controls:SquircleBorder>

                        <TextBlock Text="Sẵn sàng giám sát AI Agents"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12.6"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Tự động bắt tín hiệu Antigravity CLI, Teamwork, Codex &amp; Claude Code (0% CPU khi rảnh)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.6"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="265"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource NotchPillButton}"
                                Command="{Binding FocusPrimaryAgentCommand}"
                                Padding="8,0"
                                ToolTip="Chuyển nhanh tới cửa sổ Terminal hoặc IDE">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:IconsaxIcon Kind="ExportTray"
                                                      Size="11.5"
                                                      Foreground="#93C5FD"
                                                      Margin="0,0,5,0"
                                                      VerticalAlignment="Center" />
                                <TextBlock Text="Mở Terminal / IDE"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource NotchPillButton}"
                                Command="{Binding CopyAgentHookCommand}"
                                Padding="9,0"
                                ToolTip="Sao chép cấu hình .agents/hooks.json mẫu vào Clipboard">
                            <TextBlock Text="{Binding AgentHookButtonText}"
                                       FontSize="10.4"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>

                <!-- Active / Populated Primary Agent Card -->
                <Grid Visibility="{Binding HasAnyAgents, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Provider Badge + Live Status Pill + Elapsed Timer -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:SquircleBorder Width="26"
                                                     Height="26"
                                                     CornerRadius="6.8"
                                                     Background="{Binding PrimaryAgent.StatusPillBackgroundBrush}"
                                                     BorderBrush="{Binding PrimaryAgent.StatusPillBorderBrush}"
                                                     BorderThickness="1"
                                                     Margin="0,0,7.5,0">
                                <controls:IconsaxIcon Kind="{Binding PrimaryAgent.ProviderIcon}"
                                                      Size="13.5"
                                                      Foreground="{Binding PrimaryAgent.StatusTextBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                            </controls:SquircleBorder>

                            <TextBlock Text="{Binding PrimaryAgent.ProviderBadge}"
                                       Foreground="#A6B2CA"
                                       FontSize="10.3"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:SquircleBorder CornerRadius="6"
                                                     Background="{Binding PrimaryAgent.StatusPillBackgroundBrush}"
                                                     BorderBrush="{Binding PrimaryAgent.StatusPillBorderBrush}"
                                                     BorderThickness="1"
                                                     Padding="7,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="5.5"
                                             Height="5.5"
                                             Fill="{Binding PrimaryAgent.StatusDotBrush}"
                                             Margin="0,0,4.5,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PrimaryAgent.StatusBadgeText}"
                                               Foreground="{Binding PrimaryAgent.StatusTextBrush}"
                                               FontSize="10.3"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </controls:SquircleBorder>

                            <TextBlock Text="{Binding PrimaryAgent.ElapsedText}"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="#8E98AE"
                                       FontSize="10.6"
                                       FontWeight="Medium"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Primary Task / Session Title -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding PrimaryAgent.DisplayName}"
                               ToolTip="{Binding PrimaryAgent.DisplayName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13.2"
                               FontWeight="SemiBold"
                               Margin="0,9,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Row 2: Live Current Tool / Milestone Step Box -->
                    <controls:SquircleBorder Grid.Row="2"
                                             Margin="0,8,0,0"
                                             CornerRadius="8.5"
                                             Background="#14FFFFFF"
                                             BorderBrush="#20FFFFFF"
                                             BorderThickness="1"
                                             Padding="9.5,6.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <controls:IconsaxIcon Grid.Column="0"
                                                  Kind="Flash"
                                                  Size="12"
                                                  Foreground="{Binding PrimaryAgent.StatusTextBrush}"
                                                  Margin="0,0,6.5,0"
                                                  VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PrimaryAgent.CurrentActionText}"
                                       ToolTip="{Binding PrimaryAgent.CurrentActionText}"
                                       Foreground="#DCE4F5"
                                       FontSize="11.1"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </controls:SquircleBorder>

                    <!-- Row 3: Swarm Counter Summary + Action Buttons -->
                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding AgentSwarmSummaryText}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="#8D98AF"
                                   FontSize="10.3"
                                   Margin="1,0,0,7"
                                   TextTrimming="CharacterEllipsis" />

                        <Grid Grid.Row="1" Height="27">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource NotchPillButton}"
                                    Command="{Binding FocusPrimaryAgentCommand}"
                                    Padding="8,0"
                                    ToolTip="Đưa cửa sổ Terminal / IDE chứa Agent này lên trên cùng">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:IconsaxIcon Kind="ExportTray"
                                                          Size="11.5"
                                                          Foreground="#93C5FD"
                                                          Margin="0,0,5,0"
                                                          VerticalAlignment="Center" />
                                    <TextBlock Text="Mở cửa sổ"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource NotchPillButton}"
                                    Command="{Binding CopyAgentHookCommand}"
                                    Padding="8.5,0"
                                    ToolTip="Sao chép cấu hình .agents/hooks.json mẫu vào Clipboard">
                                <TextBlock Text="{Binding AgentHookButtonText}"
                                           FontSize="10.3"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </Button>

                            <Button Grid.Column="4"
                                    Style="{StaticResource NotchPillButton}"
                                    Command="{Binding ClearCompletedAgentsCommand}"
                                    Padding="8.5,0"
                                    ToolTip="Ẩn các phiên đã chạy xong khỏi danh sách">
                                <TextBlock Text="Dọn xong"
                                           FontSize="10.3"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </controls:SquircleBorder>

        <!-- ======================================================================= -->
        <!-- CARD 2 (RIGHT): PARALLEL SESSIONS & SUBAGENTS LIVE STREAM               -->
        <!-- ======================================================================= -->
        <controls:SquircleBorder Grid.Column="2"
                                 Background="{StaticResource FrostedCardBrush}"
                                 BorderBrush="{StaticResource FrostedCardBorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="14"
                                 Padding="14,11,14,11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Stream Header -->
                <Grid Grid.Row="0" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Hierarchy"
                                              Size="13.5"
                                              Foreground="#60A5FA"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="Phiên &amp; Subagents trực tiếp"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11.4"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding AgentStreamCountBadge}"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#93C5FD"
                               FontSize="10.4"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Empty Stream Hint -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasAnyAgents, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="Chưa có phiên hoạt động gần đây"
                               Foreground="#B4BED4"
                               FontSize="11.3"
                               FontWeight="Medium"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Khi bạn chạy /teamwork, Antigravity hoặc Codex, từng Worker &amp; Subagent sẽ hiện trực tiếp tại đây"
                               Foreground="#7E889E"
                               FontSize="10.3"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="255"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Scrollable Agent Session Cards -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="OnAgentStreamWheel"
                              Visibility="{Binding HasAnyAgents, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding AgentSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.FocusAgentSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SessionId}"
                                        Cursor="Hand"
                                        Focusable="False"
                                        Margin="0,0,0,5.5"
                                        ToolTip="Nhấp để nhảy tới cửa sổ chứa Agent này">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <controls:SquircleBorder x:Name="RowBd"
                                                                     CornerRadius="8.5"
                                                                     Background="#13FFFFFF"
                                                                     BorderBrush="#1EFFFFFF"
                                                                     BorderThickness="1"
                                                                     Padding="9,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0"
                                                             Width="7"
                                                             Height="7"
                                                             Fill="{Binding StatusDotBrush}"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding ShortProviderTag}"
                                                                       Foreground="{Binding StatusTextBrush}"
                                                                       FontSize="9.8"
                                                                       FontWeight="Bold"
                                                                       Margin="0,0,5,0"
                                                                       VerticalAlignment="Center" />

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       Foreground="#F1F5FC"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <TextBlock Text="{Binding CurrentActionText}"
                                                                   Foreground="#96A2B8"
                                                                   FontSize="10.1"
                                                                   Margin="0,1.5,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   Foreground="{Binding StatusTextBrush}"
                                                                   FontSize="9.8"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding RelativeTimeText}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Foreground="#78839B"
                                                                   FontSize="9.4"
                                                                   Margin="0,1.5,0,0"
                                                                   HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </controls:SquircleBorder>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#22FFFFFF" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#34FFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsWaitingApproval}" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#1CF59E0B" />
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#4AFBBF24" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </controls:SquircleBorder>
    </Grid>
</UserControl>
