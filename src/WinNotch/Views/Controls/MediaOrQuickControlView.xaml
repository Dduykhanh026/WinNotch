<UserControl x:Class="WinNotch.Views.Controls.MediaOrQuickControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WinNotch.Views.Controls">

    <controls:SquircleBorder Background="{StaticResource FrostedCardBrush}"
                             BorderBrush="{StaticResource FrostedCardBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="14">
        <Grid>
            <!-- ========================================================= -->
            <!-- MODE A: ACTIVE MEDIA SESSION (NOW PLAYING + AMBIENT GLOW) -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding HasMediaSession, Converter={StaticResource BoolToVis}}">
                <!-- Ambient Album Color Radial Glow (G2 Squircle Clipped) -->
                <controls:SquircleBorder Background="{Binding AmbientGlowColor, Converter={StaticResource ColorToGlowBrush}}"
                                         CornerRadius="14"
                                         IsHitTestVisible="False" />

                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: True G2 Continuous Apple Squircle Album Art (60x60, r=12.5 ~21%) + Track Info -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="60" Height="60">
                            <controls:SquircleBorder CornerRadius="12.5"
                                                     Background="#20FFFFFF"
                                                     BorderBrush="#2CFFFFFF"
                                                     BorderThickness="1"
                                                     Visibility="{Binding AlbumArt, Converter={StaticResource NullToInvVis}}">
                                <controls:IconsaxIcon Kind="Music"
                                                      Size="24"
                                                      Foreground="#C8D0E4"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                            </controls:SquircleBorder>

                            <controls:SquircleBorder CornerRadius="12.5"
                                                     BorderBrush="#34FFFFFF"
                                                     BorderThickness="1"
                                                     RenderOptions.BitmapScalingMode="HighQuality"
                                                     Visibility="{Binding AlbumArt, Converter={StaticResource NullToVis}}">
                                <controls:SquircleBorder.Background>
                                    <ImageBrush ImageSource="{Binding AlbumArt}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality" />
                                </controls:SquircleBorder.Background>
                            </controls:SquircleBorder>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding MediaTitle}"
                                           ToolTip="{Binding MediaTitle}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Top-Right Now Playing Widget 5-Bar Symmetric Waveform -->
                                <controls:SmoothWaveVisualizer Grid.Column="1"
                                                               Height="16"
                                                               BarWidth="2.0"
                                                               BarGap="2.2"
                                                               Margin="10,0,2,0"
                                                               VerticalAlignment="Center"
                                                               IsPlaying="{Binding IsMediaPlaying}"
                                                               HasAlbumArt="{Binding HasAlbumArt}"
                                                               BassLevel="{Binding WaveBassLevel}"
                                                               MidLevel="{Binding WaveMidLevel}"
                                                               TrebleLevel="{Binding WaveTrebleLevel}"
                                                               AccentColor="{Binding AmbientGlowColor}" />
                            </Grid>

                            <TextBlock Text="{Binding MediaArtist}"
                                       ToolTip="{Binding MediaArtist}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="Regular"
                                       Margin="0,2.5,0,0"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{Binding MediaSourceName}"
                                       Foreground="#88FFFFFF"
                                       FontSize="10.8"
                                       FontWeight="Regular"
                                       Margin="0,3.5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Interactive Seekbar -->
                    <Grid Grid.Row="1" Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="35" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding PositionLabel}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.8"
                                   FontWeight="Regular"
                                   VerticalAlignment="Center" />

                        <Slider x:Name="MediaSeekSlider"
                                Grid.Column="1"
                                Style="{StaticResource NotchSleekSlider}"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding SeekSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding CanSeek}"
                                Margin="8,0"
                                Thumb.DragStarted="OnSeekDragStarted"
                                Thumb.DragCompleted="OnSeekDragCompleted"
                                PreviewMouseLeftButtonDown="OnSeekMouseDown"
                                PreviewMouseLeftButtonUp="OnSeekMouseUp" />

                        <TextBlock Grid.Column="2"
                                   Text="{Binding DurationLabel}"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="10.8"
                                   FontWeight="Regular"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 2: Iconsax Transport Controls -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom">
                        <Button Style="{StaticResource NotchGhostButton}"
                                Command="{Binding PreviousTrackCommand}"
                                Width="38"
                                Height="32"
                                Padding="0"
                                ToolTip="Bài trước">
                            <controls:IconsaxIcon Kind="Previous" Size="16.5" />
                        </Button>

                        <Button Style="{StaticResource NotchPillButton}"
                                Command="{Binding TogglePlayPauseCommand}"
                                Width="54"
                                Height="32"
                                Margin="11,0"
                                Padding="0"
                                ToolTip="Phát / Tạm dừng">
                            <controls:IconsaxIcon Kind="{Binding PlayPauseIcon}" Size="17.5" />
                        </Button>

                        <Button Style="{StaticResource NotchGhostButton}"
                                Command="{Binding NextTrackCommand}"
                                Width="38"
                                Height="32"
                                Padding="0"
                                ToolTip="Bài tiếp theo">
                            <controls:IconsaxIcon Kind="Next" Size="16.5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ====================================================================== -->
            <!-- MODE B: RESTING IDLE NOW PLAYING WIDGET (1:1 SILHOUETTE, NO JUMPING)   -->
            <!-- ====================================================================== -->
            <Grid Visibility="{Binding HasMediaSession, Converter={StaticResource InvBoolToVis}}"
                  Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Frosted 60x60 Squircle Album Art Placeholder + Resting Waveform Dots -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SquircleBorder Grid.Column="0"
                                             Width="60"
                                             Height="60"
                                             CornerRadius="12.5"
                                             Background="#18FFFFFF"
                                             BorderBrush="#26FFFFFF"
                                             BorderThickness="1">
                        <controls:IconsaxIcon Kind="Music"
                                              Size="24"
                                              Foreground="#94A3B8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                    </controls:SquircleBorder>

                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Chưa có nhạc đang phát"
                                       Foreground="#EDF2FC"
                                       FontSize="13.2"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <controls:SmoothWaveVisualizer Grid.Column="1"
                                                           Height="16"
                                                           BarWidth="2.0"
                                                           BarGap="2.2"
                                                           Margin="10,0,2,0"
                                                           VerticalAlignment="Center"
                                                           IsPlaying="False" />
                        </Grid>

                        <TextBlock Text="Mở trình phát để điều khiển &amp; xem sóng âm"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.2"
                                   FontWeight="Regular"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="Spotify • Apple Music • YouTube"
                                   Foreground="#76FFFFFF"
                                   FontSize="10.4"
                                   FontWeight="Regular"
                                   Margin="0,3.5,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Row 1: Subtle Resting Timeline (Matches Mode A Seekbar 1:1) -->
                <Grid Grid.Row="1" Height="18" Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="35" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="00:00"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#64FFFFFF"
                               FontSize="10.8"
                               FontWeight="Regular"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Height="5"
                            CornerRadius="2.5"
                            Background="#1CFFFFFF"
                            Margin="8,0"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="--:--"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="#64FFFFFF"
                               FontSize="10.8"
                               FontWeight="Regular"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Row 2: Quick-Launch Last Media Player Pill (Aligned to Mode A Transport Row) -->
                <Button Grid.Row="2"
                        Style="{StaticResource NotchPillButton}"
                        Command="{Binding LaunchLastMediaAppCommand}"
                        Height="32"
                        Padding="15,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        ToolTip="Khởi chạy nhanh trình phát nhạc">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconsaxIcon Kind="Music"
                                              Size="14"
                                              Foreground="#93C5FD"
                                              Margin="0,0,7,0"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LastMediaAppButtonText}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </controls:SquircleBorder>
</UserControl>
