<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>WinNotch</AssemblyName>
    <RootNamespace>WinNotch</RootNamespace>
    <Version>1.0.0</Version>
    <Product>WinNotch</Product>
    <Company>WinNotch</Company>
    <Description>Dynamic Notch Overlay for Windows 10 &amp; 11 (100% Offline)</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent WinForms / System.Drawing implicit usings from colliding with WPF types -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom Program.Main entry point for Velopack fast-hook & Single-Instance Mutex -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Fonts\SF-Pro-Display-Regular.otf" />
    <Resource Include="Assets\Fonts\SF-Pro-Display-Medium.otf" />
    <Resource Include="Assets\Fonts\SF-Pro-Display-Semibold.otf" />
    <Resource Include="Assets\Fonts\SF-Pro-Display-Bold.otf" />
    <EmbeddedResource Include="Assets\chime.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="9.0.2" />
    <PackageReference Include="Velopack" Version="0.0.1053" />
  </ItemGroup>

</Project>
